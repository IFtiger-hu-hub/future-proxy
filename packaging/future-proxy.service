[Unit]
Description=Future Proxy (mihomo core)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/future-proxy-core -d %h/.config/future-proxy
ExecStartPost=/usr/bin/future-proxy-sysproxy on
ExecStopPost=/usr/bin/future-proxy-sysproxy off
Restart=on-failure
RestartSec=3
TimeoutStopSec=2
KillMode=process

[Install]
WantedBy=default.target
